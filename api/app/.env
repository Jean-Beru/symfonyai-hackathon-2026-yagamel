# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> app ###
# KServe v2 server of the YOLO model (OpenVINO Model Server).
YOLO_URL=http://yolo:8000
# Seconds without an answer of YOLO before a 504.
YOLO_TIMEOUT=10
BALL_MIN_CONFIDENCE=0.10
# The model gives at most 10 boxes per frame.
BALL_MAX_CANDIDATES=10
LOG_LEVEL=info
# POST /frames: a YOLO candidate is the ball from this confidence.
REFEREE_MIN_CONFIDENCE=0.3
# A goal: the ball is in a goal, then no ball for this number of frames in a row (60 frames per second).
GOAL_MISSING_FRAMES=15
# A gamelle: the ball is in a goal, then out of it for this number of frames.
GAMELLE_OUTSIDE_FRAMES=5
# The live page: the path of the ball over this number of seconds, up to the frame shown.
PATH_SECONDS=5
###< app ###

###> symfony/mercure-bundle ###
# See https://symfony.com/doc/current/mercure.html#configuration
# Empty: Symfony publishes with mercure_publish(), in the process of FrankenPHP, without HTTP. The live page
# subscribes on the same origin, without a token.
MERCURE_URL=
# The key and the issuer of the publisher JWT, the same in frankenphp/Caddyfile. Set another key in compose.yaml.
MERCURE_JWT_SECRET="!ChangeThisMercureHubJWTSecretKey!"
MERCURE_JWT_ISSUER=yolo-api
###< symfony/mercure-bundle ###
